# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# The functions package installs its own. `/node_modules` above is anchored to
# the repo root and does not cover it.
/functions/node_modules
# Compiled output. `firebase deploy` builds it from source on the way up, so a
# committed copy is only ever a stale one.
/functions/lib
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and every contributor needs it.
!.env.example

# Firebase service account keys. The Admin SDK bypasses Security Rules, so
# these grant total access to the project.
service-account*.json
*-firebase-adminsdk-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings. Accumulated per machine, with absolute paths in
# them — not shared project config.
.claude/

.vercel
.env*

# Firebase CLI debug logs, written into the repo root on every failed command.
firebase-debug.log
firestore-debug.log
ui-debug.log
